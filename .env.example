

# ---------------------------------------------------------------------------
# Contact form mailer (public/api/contact.php)
# `npm run build` copies these into out/api/env.php for the server.
# Never prefix secrets with NEXT_PUBLIC_ (those are visible in the browser).
# ---------------------------------------------------------------------------

# Who receives enquiries (comma-separated for several)
CONTACT_TO=info@digitalinvoice.ng

# Sender on both emails: an address on your domain that the SMTP account may send from
CONTACT_FROM_EMAIL=no-reply@your-domain.example
CONTACT_FROM_NAME=Teecoms Integrated Solutions

# SMTP account (cPanel: Email Accounts > Connect Devices)
SMTP_HOST=mail.your-domain.example
SMTP_PORT=465
# ssl (port 465) | tls (port 587) | none
SMTP_SECURE=ssl
SMTP_USERNAME=no-reply@your-domain.example
SMTP_PASSWORD=

# Address used for the logo and links inside the emails (defaults to NEXT_PUBLIC_SITE_URL)
CONTACT_SITE_URL=

# If secure connections fail because the mail server's certificate is issued to a
# different name (common on cPanel): first set SMTP_HOST to that name (the
# diagnostics page shows it). Last resort: false
SMTP_VERIFY_PEER=true

# smtp (default) | mail (the host's built-in mailer, if outgoing SMTP is blocked)
CONTACT_TRANSPORT=smtp

# Troubleshooting. Turn both off again when email works.
# true: failed sends include the mail server's reason (browser console + response)
CONTACT_DEBUG=false
# Any long random string enables /api/contact.php?action=diagnose&key=THAT_STRING
# (add &send=1 to also send a test email). Leave empty to disable the page.
CONTACT_DIAGNOSTICS_KEY=

# Send the visitor a confirmation email (true | false)
CONTACT_AUTO_REPLY=true

# Spam protection
# Max submissions per visitor in the window (seconds)
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW=600
# Forms sent faster than this after loading are treated as bots
CONTACT_MIN_SECONDS=3
# Optional: long random string used to sign form tokens (one is derived if empty)
CONTACT_TOKEN_SECRET=
# Only if the form is hosted on another domain (comma-separated origins)
CONTACT_ALLOWED_ORIGINS=

# Optional Cloudflare Turnstile (free, usually invisible human check).
# Create keys at dash.cloudflare.com > Turnstile. Leave both empty to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Contact form endpoint override (default: /api/contact.php)
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Office address shown in the Contact section (defaults to the verified address in src/config/site.js)
NEXT_PUBLIC_CONTACT_ADDRESS=
